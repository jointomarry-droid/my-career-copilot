# ─── LLM Engine Credentials ─────────────────────────
# Using Anthropic Claude API for dynamic application form-filling (Essays, Cover Letters)
LLM_API_ENDPOINT=https://api.anthropic.com/v1/messages
LLM_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-20250514

# ─── MongoDB Database ────────────────────────────────
# Persistent storage for users, applications, logs, discoveries, campaigns
# Falls back to in-memory if not set
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/career_copilot
MONGODB_DB=career_copilot

# ─── Database Connections (Legacy/Supabase) ──────────
DATABASE_URL=postgres://user:password@aws-region.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Email Notifications (Nodemailer SMTP) ───────────
# Gmail: smtp.gmail.com / 587
# Outlook: smtp.office365.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
NOTIFICATION_EMAIL=your_email@gmail.com
FROM_EMAIL=AI Career Copilot <copilot@careercopilot.ai>

# ─── Global Proxy Networks ───────────────────────────
# For anti-captcha bypassing (e.g. Oxylabs, BrightData)
PROXY_SERVER_EU=http://proxy-gateway.eu.service.com:8080
PROXY_SERVER_US=http://proxy-gateway.us.service.com:8080
PROXY_USERNAME=your_proxy_user
PROXY_PASSWORD=your_proxy_pass

# ─── Playwright Debug Settings ────────────────────────
HEADLESS_MODE=true
PLAYWRIGHT_TIMEOUT_MS=60000

# ─── Secret Auth ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_random_jwt_secret_key_here